<Window x:Class="TT_PPID_CS.UI.Views.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:TT_PPID_CS.UI.Views"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="550" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="10,10,0,0" Padding="15">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Bold"/>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBox Text="{Binding User.UserName}" md:HintAssist.Hint="用户名 *" 
                             IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

                    <TextBox Text="{Binding User.FullName}" md:HintAssist.Hint="全名" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

                    <TextBox Text="{Binding User.Email}" md:HintAssist.Hint="邮箱" 
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding User.Role}"
                              md:HintAssist.Hint="角色" 
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15"/>

                    <CheckBox IsChecked="{Binding User.IsActive}" Content="启用账户" Margin="0,0,0,15"/>

                    <Separator Margin="0,10"/>
                    <TextBlock Text="密码设置" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <PasswordBox x:Name="PasswordBox" md:HintAssist.Hint="密码"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,15"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    
                    <PasswordBox x:Name="ConfirmPasswordBox" md:HintAssist.Hint="确认密码"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,15"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15">
                <Button Content="取消" IsCancel="True" Click="CancelButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="保存" IsDefault="True" Click="SaveButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
